+  torch_proc_type: ${{ "rocm" ~ hip_compiler_version | version_to_buildstring if hip_compiler_version != "None" else ("cuda" ~ cuda_compiler_version | version_to_buildstring if cuda_compiler_version != "None" else "cpu") }}
   # ensure arm_variant_type gets detected as a used variable
   touch_arm_variant_type: ${{ arm_variant_type | default("None") }}
 
