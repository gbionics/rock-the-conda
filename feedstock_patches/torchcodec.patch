+            - import os
             - import subprocess
             - import sys
             - tests_to_skip = []
             - test_paths = ["test"]
-            - pytest_extra_args = []
+            # Prevent pytest from finding rock-the-conda's pyproject.toml above
+            # the test prefix: otherwise --deselect node IDs have the wrong root.
+            - pytest_extra_args = ["--rootdir=.", "-c", os.devnull]
+            - if: hip_compiler_version != "None"
+              then:
+                - |
+                  # This package has CPU media codecs; PyTorch's CUDA API also
+                  # reports AMD GPUs as available, which enables NVIDIA-only tests.
+                  os.environ["HIP_VISIBLE_DEVICES"] = ""
+                  os.environ["ROCR_VISIBLE_DEVICES"] = ""
