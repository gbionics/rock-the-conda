+            - libhipcub-devel
+            - libhipblas-common-devel
+            - libhipblas-devel
+            - libhipblaslt-devel
+            - libhipfft-devel
+            - libhipsparse-devel
+            - libhipsolver-devel
+            - libhiprand-devel
+            - libmiopen-hip-devel
       run:
         - python
         # We temporary relatex the pytorch dependency on to be compatible with torchvision,
