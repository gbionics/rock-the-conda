diff --git a/recipe/rocm_third_party_interface.patch b/recipe/rocm_third_party_interface.patch
new file mode 100644
index 0000000000000000000000000000000000000000..bc13a0c90d695273e0168b36aaaefe1249aa56a6
--- /dev/null
+++ b/recipe/rocm_third_party_interface.patch
@@ -0,0 +1,27 @@
+ROCm-linked Torch extensions need hip::host and PyTorch 2.14 requires C++20.
+
+--- a/test/third-party-interface/CMakeLists.txt
++++ b/test/third-party-interface/CMakeLists.txt
+@@ -8,9 +8,12 @@
+ 
+ cmake_minimum_required(VERSION 3.18)
+ project(ThirdPartyInterfaceTest)
+-set(CMAKE_CXX_STANDARD 17)
++set(CMAKE_CXX_STANDARD 20)
+ set(CMAKE_CXX_STANDARD_REQUIRED ON)
+ 
++# This extension has no HIP sources, but Torch's imported targets refer to
++# hip::host. Load the Conda HIP package even when /opt/rocm is absent.
++find_package(hip REQUIRED CONFIG)
+ find_package(Torch REQUIRED)
+ find_package(TorchCodec REQUIRED)
+ 
+@@ -21,7 +24,7 @@
+     # Building executable to check the linkage
+     add_library(${libname} SHARED ${sources})
+     set_target_properties(${libname} PROPERTIES PREFIX "")
+-    set_target_properties(${libname} PROPERTIES CXX_STANDARD 17)
++    set_target_properties(${libname} PROPERTIES CXX_STANDARD 20)
+     target_link_libraries(${libname}
+       ${TORCH_LIBRARIES}
+       torchcodec::core${torchcodec_variant}
